{
  "id": "com.syncro.os",
  "name": "Syncro OS",
  "short_name": "Syncro",
  "description": "Aplikasi Manajemen Bisnis Kuliner",
  "version": "1.0.1",
  "start_url": "/Syncro-OS/",
  "scope": "/Syncro-OS/",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "scope_extensions": [
    {
      "origin": "https://syncro-os.web.app"
    }
  ],
  "background_color": "#4F46E5",
  "theme_color": "#4F46E5",
  "orientation": "portrait-primary",
  "lang": "id",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities",
    "business",
    "finance"
  ],
  "handle_links": "preferred",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://syncro-os.web.app/manifest.json",
      "id": "syncro-os"
    }
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "widgets": [
    {
      "name": "Syncro OS Widget",
      "description": "Ringkasan operasional bisnis Syncro OS",
      "tag": "syncro-summary",
      "template": "syncro-widget",
      "ms_ac_template": "widgets/widget-template.json",
      "data": "widgets/widget-data.json",
      "type": "application/json",
      "icons": [
        {
          "src": "apps/admin-dashboard/assets/icons/icon-192-maskable.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "auth": false,
      "update": 3600
    }
  ],
  "note_taking": {
    "new_note_url": "index.html#add-customer"
  },
  "icons": [
    {
      "src": "assets/icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "assets/screenshots/dashboard-desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard Syncro OS Desktop"
    },
    {
      "src": "assets/screenshots/dashboard-mobile.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Dashboard Syncro OS Mobile"
    }
  ],
  "shortcuts": [
    {
      "name": "Buka Beranda",
      "short_name": "Home",
      "description": "Kembali ke halaman utama Syncro OS",
      "url": "index.html",
      "icons": [
        {
          "src": "assets/icons/icon-192-maskable.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Tambah Transaksi",
      "short_name": "Transaksi",
      "description": "Tambah transaksi baru",
      "url": "index.html#transaksi",
      "icons": [
        {
          "src": "assets/icons/icon-192-maskable.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "share-target.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "index.html",
      "accept": {
        "text/csv": [
          ".csv"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+syncro",
      "url": "index.html?url=%s"
    }
  ]
}
